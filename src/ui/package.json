{
  "name": "intel-enterprise-rag-ui-workspace",
  "version": "3.0.0",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "lint": "eslint \"**/*.{ts,tsx,js,jsx}\"",
    "lint:fix": "eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "typecheck": "pnpm -r run typecheck",
    "validate": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm -r build && pnpm audit",
    "validate:fix": "pnpm run lint:fix && pnpm run format && pnpm audit --fix"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.7",
    "@tanstack/react-table": "^8.20.6",
    "@tanstack/react-virtual": "^3.13.12",
    "@xyflow/react": "^12.3.1",
    "classnames": "^2.5.1",
    "dompurify": "^3.3.2",
    "lodash.debounce": "^4.0.8",
    "luxon": "^3.6.1",
    "react": "^18.3.1",
    "react-aria-components": "^1.7.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^7.18.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@types/lodash.debounce": "4.0.9",
    "@types/luxon": "3.7.1",
    "@types/node": "22.19.13",
    "@types/punycode": "2.1.4",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/uuid": "10.0.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.27",
    "eslint": "9.39.3",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "globals": "15.15.0",
    "postcss": "8.5.26",
    "prettier": "3.8.1",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.6.14",
    "sass": "1.97.3",
    "tailwindcss": "3.4.19",
    "tailwindcss-react-aria-components": "1.2.0",
    "typescript": "5.9.3",
