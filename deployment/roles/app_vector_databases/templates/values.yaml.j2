{# With projected Secrets (ESO) the chart templates no Secret and no password
   is rendered here. #}
{% if app_secrets_projected | default(false) %}
externalSecrets: true
{% endif %}

{% if vector_databases_vector_store == "pgvector" %}
{% if not (app_secrets_projected | default(false)) %}
vector_database_password: {{ POSTGRES_PASSWORD }}
{% endif %}
vector_database_username: {{ vector_database_connection_username | default("edp") }}
vector_database_name: {{ vector_database_name | default("vdb") }}

pgvector:
  enabled: true
{% endif %}

{% if vector_databases_vector_store == "mssql" %}
{% set mssql = vector_databases_stores.mssql %}
{% if not (app_secrets_projected | default(false)) %}
vector_database_password: {{ MSSQL_PASSWORD }}
{% endif %}
vector_database_username: {{ vector_database_connection_username | default("edp") }}
vector_database_name: {{ vector_database_name | default("vdb") }}

mssql:
  enabled: true
  config:
    accept_eula: {{ mssql_eula_accept | quote }}
    mssql_pid: {{ mssql.mssql_pid | quote }}
{% endif %}

{% if vector_databases_vector_store == "redis-cluster" %}
{% set redis = vector_databases_stores['redis-cluster'] %}

vectorStore: {{ vector_databases_vector_store }}
{% if not (app_secrets_projected | default(false)) %}
vector_database_password: {{ REDIS_PASSWORD }}
{% endif %}

redis-cluster:
  cluster:
    nodes: {{ redis.cluster.nodes | default(3) }}
    replicas: {{ redis.cluster.replicas | default(0) }}
  image:
    repository: {{ redis.image.repository | default('redis') }}
  redis:
    image:
      repository: {{ redis.image.repository | default('redis') }}
      tag: "{{ redis.image.tag | default('8.2.2') }}"
      pullPolicy: {{ redis.image.pullPolicy | default('IfNotPresent') }}
    resources:
      requests:
        cpu: "{{ '100m' if (minimal_configuration is defined and minimal_configuration) else redis.resources.requests.cpu | default('500m') }}"
        memory: "{{ redis.resources.requests.memory | default('512Mi') }}"
      limits:
        cpu: "{{ redis.resources.limits.cpu | default('2000m') }}"
        memory: "{{ redis.resources.limits.memory | default('4Gi') }}"
  persistence:
    storageClass: "{{ redis.persistence.storageClass | default('') }}"
    size: "{{ redis.persistence.size | default('8Gi') }}"

{% endif %}
