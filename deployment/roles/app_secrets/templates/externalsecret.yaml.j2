   openbao adapter: one ExternalSecret per registry secrets: entry, rendered by
   tasks/adapters/openbao/render_externalsecrets.yaml from
   _app_secrets_es_render (no values: KV references and literals only).

   The target template is a Go template. Its placeholders reach this file as
   @@SK:<secretKey>@@ and are turned into Go actions only here, in the
   rendered text, so they never pass through Ansible variable templating. #}
{% set _go_open = '{' ~ '{ .' %}
{% set _go_close = ' }' ~ '}' %}
{% for es in _app_secrets_es_render %}
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{ es.name | to_json }}
  namespace: {{ es.namespace | to_json }}
  labels:
    app.kubernetes.io/part-of: erag-secrets
    app.kubernetes.io/managed-by: app_secrets
    {{ app_secrets_namespace_label }}: "true"
  annotations:
    erag-secrets/credential-ids: {{ es.ids | join(',') | to_json }}
spec:
  refreshPolicy: Periodic
  refreshInterval: {{ app_secrets_eso_refresh_interval | to_json }}
  secretStoreRef:
    kind: ClusterSecretStore
    name: {{ app_secrets_openbao_store | to_json }}
  target:
    name: {{ es.name | to_json }}
    creationPolicy: Owner
    deletionPolicy: Retain
    template:
      engineVersion: v2
      mergePolicy: Replace
      type: Opaque
      data:
{% for key, text in es.template.items() %}
        {{ key | to_json }}: {{ text | to_json | regex_replace('@@SK:([A-Za-z0-9_]+)@@', _go_open ~ '\\1' ~ _go_close) }}
{% endfor %}
  data:
{% for d in es.data %}
    - secretKey: {{ d.secretKey | to_json }}
      remoteRef:
        key: {{ d.key | to_json }}
        property: {{ d.property | to_json }}
{% endfor %}
{% endfor %}
